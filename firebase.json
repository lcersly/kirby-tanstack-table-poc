{
  "hosting": {
    "public": "dist/kirby-payment-overview-prototype/browser",
    "site": "kirby-tanstack-table-poc",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.map"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/demo-version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
